# QXApi
API_ADDR=:3000
GIN_MODE=debug
LOG_LEVEL=debug
LOG_FORMAT=text
DATABASE_DSN=qx:qx@tcp(localhost:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local
# make jwt-secret  (print)  |  make jwt-secret-env  (write .env)
JWT_SECRET=dev-secret-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGIN=http://localhost:5173
# base64-encoded 32-byte key for SSH private key encryption (dev default in config)
SSH_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# QXLauncher (Windows tray)
QX_API_BASE_URL=http://localhost:3000/api/v1
QX_WEB_BASE_URL=http://localhost:5173
# QX_SKIP_TRAY=1
# QX_LAUNCH_DRY_RUN=1

# QXWeb (Vite dev)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_LOG_LEVEL=debug
# Optional: direct download URL for QXLauncher binary (Windows)
# VITE_LAUNCHER_DOWNLOAD_URL=
