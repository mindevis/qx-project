# syntax=docker/dockerfile:1

FROM golang:1.22-alpine AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /src

COPY go.work go.work.sum ./
COPY pkg/log pkg/log
COPY pkg/mcmanifest pkg/mcmanifest
COPY pkg/protocol pkg/protocol
COPY services/qxapi services/qxapi

WORKDIR /src/services/qxapi
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/qx-api ./cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/qx-api /usr/local/bin/qx-api
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/qx-api"]
