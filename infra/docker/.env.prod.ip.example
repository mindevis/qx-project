# Prod без домена — platform VPS по IP (пример: 178.172.136.26).
# cp .env.prod.ip.example .env.prod && заполните секреты (make jwt-secret).
# Guide: docs/production-deploy.md § «Prod по IP»

# Nginx на стандартном порту 80 (ufw allow 80/tcp)
HTTP_PORT=80
CORS_ORIGIN=http://178.172.136.26
QX_PUBLIC_API_URL=http://178.172.136.26

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=qx
MYSQL_USER=qx
MYSQL_PASSWORD=change-me-qx
DATABASE_DSN=qx:change-me-qx@tcp(mysql:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local

JWT_SECRET=change-me-use-make-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SSH_MASTER_KEY=change-me-base64-32-bytes

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

LOG_LEVEL=info
LOG_FORMAT=json

QX_AGENT_BINARY_PATH=/opt/qx/bin/qx-agent-linux
QX_AGENT_BINARY_HOST_PATH=../../bin/qx-agent-linux
