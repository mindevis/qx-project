# Copy to .env.prod — prod Docker Compose only (dev uses qxapi.toml, web.toml, launcher.toml).
# Full guide: docs/production-deploy.md

# Split domains (recommended prod): api.qx-dev.ru + mc.qx-dev.ru
# cp .env.prod.qx-dev.example .env.prod
# Single origin (one host, path /api/): NGINX_CONF=prod.conf, VITE_API_BASE_URL=/api/v1

HTTP_PORT=80
NGINX_CONF=prod-split.conf
CORS_ORIGIN=https://mc.qx-dev.ru
QX_PUBLIC_API_URL=https://api.qx-dev.ru
VITE_API_BASE_URL=https://api.qx-dev.ru/api/v1

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=qx
MYSQL_USER=qx
MYSQL_PASSWORD=change-me-qx
DATABASE_DSN=qx:change-me-qx@tcp(mysql:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local

# Run: make jwt-secret — use output for JWT_SECRET and SSH_MASTER_KEY (different values!)
JWT_SECRET=change-me-use-make-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# base64-encoded 32-byte key — run: make jwt-secret
SSH_MASTER_KEY=change-me-base64-32-bytes

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

LOG_LEVEL=info
LOG_FORMAT=json

# QXAgent binary mounted into API container for SSH deploy (build: make build-agent-linux).
QX_AGENT_BINARY_PATH=/opt/qx/bin/qx-agent-linux
# Host path relative to infra/docker/ (default: repo bin/qx-agent-linux)
QX_AGENT_BINARY_HOST_PATH=../../bin/qx-agent-linux
