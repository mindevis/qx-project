# Copy to .env.prod — prod Docker Compose only (dev uses qxapi.toml, web.toml, launcher.toml).

HTTP_PORT=8080
CORS_ORIGIN=http://localhost:8080
QX_PUBLIC_API_URL=http://localhost:8080

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=qx
MYSQL_USER=qx
MYSQL_PASSWORD=change-me-qx
DATABASE_DSN=qx:change-me-qx@tcp(mysql:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local

JWT_SECRET=change-me-use-make-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# base64-encoded 32-byte key — run: make jwt-secret
SSH_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

LOG_LEVEL=info
LOG_FORMAT=json

# Path to qx-agent binary on the API host (required for SSH deploy).
QX_AGENT_BINARY_PATH=/opt/qx/bin/qx-agent-linux
