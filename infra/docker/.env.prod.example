# Reference: keys rendered into .env.prod by GitHub Actions (infra/scripts/prod-render-env.sh).
# Do not commit .env.prod. Set values as repository Secrets — docs/production-deploy.md

HTTP_PORT=80
CORS_ORIGIN=https://mc.qx-dev.ru
QX_PUBLIC_API_URL=https://mc.qx-dev.ru

# Secrets → GitHub Actions:
# PROD_MYSQL_ROOT_PASSWORD, PROD_MYSQL_PASSWORD, PROD_MINIO_PASSWORD
# PROD_JWT_SECRET, PROD_SSH_MASTER_KEY
MYSQL_DATABASE=qx
MYSQL_USER=qx

ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=168h
MINIO_ROOT_USER=minio
LOG_LEVEL=info
LOG_FORMAT=json
QX_AGENT_BINARY_PATH=/opt/qxsystem/bin/qx-agent-linux

# Microsoft / Minecraft OAuth — custom Azure AD app (NOT the public launcher client 00000000402b5328).
# Register redirect URI exactly: https://mc.qx-dev.ru/api/v1/mojang/oauth/callback
# GitHub Secrets (environment production): MOJANG_CLIENT_ID, PROD_MOJANG_CLIENT_SECRET
# MOJANG_OAUTH_REDIRECT_URI is optional; defaults to {QX_PUBLIC_API_URL}/api/v1/mojang/oauth/callback

# QXMods catalog — CurseForge Studios API key (Modrinth works without a key).
# GitHub Secret (environment production): CURSEFORGE_API_KEY
# MODRINTH_USER_AGENT is optional; qxapi defaults to QXSystem/1.0
