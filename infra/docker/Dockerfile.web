# syntax=docker/dockerfile:1

FROM node:24-alpine AS build
WORKDIR /app
COPY web/qxweb/package.json web/qxweb/package-lock.json ./
RUN npm ci
COPY web/qxweb/ ./
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_LAUNCHER_DOWNLOAD_URL=/downloads/qx-launcher.exe
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_LAUNCHER_DOWNLOAD_URL=$VITE_LAUNCHER_DOWNLOAD_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/docker/nginx/gzip.conf /etc/nginx/gzip.conf
COPY infra/docker/nginx/web-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY bin/qx-launcher.exe /usr/share/nginx/html/downloads/qx-launcher.exe
EXPOSE 80
