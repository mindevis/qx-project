# Prod — split domains (platform VPS 178.172.136.26)
# API: https://api.qx-dev.ru   Web panel: https://mc.qx-dev.ru
# cp .env.prod.qx-dev.example .env.prod && fill secrets (make jwt-secret)
# Guide: docs/production-deploy.md § «Prod: api + mc»

HTTP_PORT=80
NGINX_CONF=prod-split.conf

# Browser CORS — origin панели (без path)
CORS_ORIGIN=https://mc.qx-dev.ru
# Agent WSS + agent.toml (без /api/v1, без trailing slash)
QX_PUBLIC_API_URL=https://api.qx-dev.ru
# Baked into QXWeb at build time — absolute API URL for cross-origin
VITE_API_BASE_URL=https://api.qx-dev.ru/api/v1

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=qx
MYSQL_USER=qx
MYSQL_PASSWORD=change-me-qx
DATABASE_DSN=qx:change-me-qx@tcp(mysql:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local

JWT_SECRET=change-me-use-make-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SSH_MASTER_KEY=change-me-base64-32-bytes

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

LOG_LEVEL=info
LOG_FORMAT=json

QX_AGENT_BINARY_PATH=/opt/qx/bin/qx-agent-linux
QX_AGENT_BINARY_HOST_PATH=../../bin/qx-agent-linux
