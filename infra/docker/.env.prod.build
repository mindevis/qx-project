# Build-only env for `docker compose build` (CI and local prod-pack without secrets).
# Runtime secrets (.env.prod on VPS) are NOT baked into images — only VITE_API_BASE_URL is.
# Guide: docs/production-deploy.md

HTTP_PORT=80
CORS_ORIGIN=https://mc.qx-dev.ru
QX_PUBLIC_API_URL=https://mc.qx-dev.ru
VITE_API_BASE_URL=https://mc.qx-dev.ru/api/v1

MYSQL_ROOT_PASSWORD=build-placeholder
MYSQL_DATABASE=qx
MYSQL_USER=qx
MYSQL_PASSWORD=build-placeholder
DATABASE_DSN=qx:build-placeholder@tcp(mysql:3306)/qx?charset=utf8mb4&parseTime=True&loc=Local

JWT_SECRET=build-placeholder-not-in-images
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
SSH_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=build-placeholder

LOG_LEVEL=info
LOG_FORMAT=json

QX_AGENT_BINARY_PATH=/opt/qxsystem/bin/qx-agent-linux
