# Copy to web.toml in repo root (preferred) or export before `npm run build`.
# Vite exposes only variables prefixed with VITE_.

# Public site URL for canonical links, Open Graph, robots.txt, and sitemap.xml.
VITE_SITE_URL=https://mc.qx-dev.ru

# API base (relative /api/v1 when served behind the same nginx host).
VITE_API_BASE_URL=/api/v1

# Optional: console log level (debug, info, warn, error).
# VITE_LOG_LEVEL=info

# Optional: override launcher download URL.
# VITE_LAUNCHER_DOWNLOAD_URL=/downloads/qx-launcher.exe
