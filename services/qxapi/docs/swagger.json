    "definitions": {
        "api.swaggerErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "VALIDATION_ERROR"
                },
                "message": {
                    "type": "string",
                    "example": "invalid request"
                }
            }
        },
        "api.swaggerErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/api.swaggerErrorBody"
                }
            }
        },
        "api.swaggerGuestRequest": {
            "type": "object",
            "properties": {
                "device_id": {
                    "type": "string",
                    "example": "00000000-0000-0000-0000-000000000001"
                }
            }
        },
        "api.swaggerGuestTokenResponse": {
            "type": "object",
            "properties": {
                "expires_in": {
                    "type": "integer",
                    "example": 86400
                },
                "guest_token": {
