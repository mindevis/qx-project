{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: dev-up",
      "type": "shell",
      "command": "make dev-up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: dev-down",
      "type": "shell",
      "command": "make dev-down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "qxweb: dev",
      "type": "npm",
      "script": "dev",
      "path": "web/qxweb",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:.*http://localhost:5173|ready in \\d+ ms)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
