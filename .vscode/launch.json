{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QXApi",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "debugAdapter": "legacy",
      "program": "${workspaceFolder}/services/qxapi/cmd",
      "cwd": "${workspaceFolder}/services/qxapi",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "showLog": true
    },
    {
      "name": "QXAgent",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "debugAdapter": "legacy",
      "program": "${workspaceFolder}/services/qxagent/cmd",
      "cwd": "${workspaceFolder}/services/qxagent",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "QXLauncher (dry-run)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "debugAdapter": "legacy",
      "program": "${workspaceFolder}/services/qxlauncher/cmd",
      "cwd": "${workspaceFolder}/services/qxlauncher",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "QX_SKIP_TRAY": "1",
        "QX_LAUNCH_DRY_RUN": "1"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "QXWeb",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web/qxweb",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Go: текущий тест",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "debugAdapter": "legacy",
      "program": "${fileDirname}",
      "cwd": "${fileDirname}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Go: тесты QXApi (пакет)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "debugAdapter": "legacy",
      "program": "${workspaceFolder}/services/qxapi/...",
      "cwd": "${workspaceFolder}/services/qxapi",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Vitest: текущий файл",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test",
        "--",
        "${relativeFile}"
      ],
      "cwd": "${workspaceFolder}/web/qxweb",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "QX Dev Stack",
      "configurations": ["QXApi", "QXWeb", "QXLauncher"],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    },
    {
      "name": "QX Dev Stack (dry-run)",
      "configurations": ["QXApi", "QXWeb", "QXLauncher (dry-run)"],
      "stopAll": true,
      "presentation": {
        "order": 2
      }
    }
  ]
}
